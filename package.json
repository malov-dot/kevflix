{
  "name": "kevflix",
  "version": "0.4.42",
  "description": "KevFLIX: local movies with PC-assisted English dubbing and upscaling. Unvalidated development build.",
  "packageType": "app",
  "appName": "KevFLIX",
  "appPath": "tv/bootstrap/index.html",
  "keys": [
    "MediaPlay",
    "MediaPause",
    "MediaPlayPause",
    "MediaStop",
    "MediaRewind",
    "MediaFastForward",
    "Info",
    "ColorF0Red"
  ],
  "license": "UNLICENSED",
  "private": true,
  "semPlayer": {
    "apiVersion": 2,
    "minimumWorker": "0.4.7-beta.5",
    "minimumTizen": "6.5",
    "targetTizenBrew": "2.0.5",
    "validation": "not-tested",
    "updateFiles": [
      "index.html",
      "player.css",
      "player.js",
      "no-native-hls.js",
      "program-audio.js",
      "program-status.js"
    ],
    "capabilities": [
      "program-player-v1"
    ],
    "programFiles": [
      "no-native-hls.js",
      "program-audio.js",
      "program-status.js"
    ],
    "playerBase": "6c0dd972bd46e2cb191494d4cd7788d2db571803 + program additions"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/malov-dot/kevflix.git"
  }
}
