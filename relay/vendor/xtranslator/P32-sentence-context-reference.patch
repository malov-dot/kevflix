+class NativeLanguagePrior:
+    """Two agreeing independent native finals; never a forced output label."""
+    def __init__(self):
+        self.seen_final_ids = deque(maxlen=64)
+        self.finals = []
+
+    def request_fields(self):
+        if len(self.finals) == 2:
+            return {'language_context_code': self.finals[-1][0],
+                    'basis_final_ids': [item[1] for item in self.finals]}
+        return {'language_context_code': None, 'basis_final_ids': []}
+
+    def observe(self, result):
+        observation_id = result.get('language_observation_id')
+        if result.get('is_final') is not True or not isinstance(observation_id, str) \
+                or re.fullmatch('[0-9a-f]{32}', observation_id) is None or observation_id in self.seen_final_ids:
+            return
+        self.seen_final_ids.append(observation_id)
+        code = result.get('language_code')
+        if result.get('language_source') != 'qwen3-asr-native' or not isinstance(code, str) \
+                or re.fullmatch('[a-z]{2}', code) is None \
+                or sum(char.isalpha() for char in result.get('text', '')) < 12:
+            return
+        if self.finals and self.finals[-1][0] != code:
+            self.finals = []
+        self.finals = (self.finals + [(code, observation_id)])[-2:]
+
+
