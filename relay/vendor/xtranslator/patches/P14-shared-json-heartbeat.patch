+def read_heartbeat(path, token, previous):
+    """A read miss never renews a previously validated absolute deadline."""
+    initial_deadline = time.monotonic() + 2.
+    while True:
+        try:
+            heartbeat = json.loads(Path(path).read_text())
+        except (OSError, ValueError) as error:
+            if isinstance(error, OSError) and not isinstance(error, FileNotFoundError) \
+                    and error.errno not in (errno.EACCES, errno.EPERM, errno.EBUSY, errno.ETXTBSY):
+                raise MonitorFailed('Heartbeat read failed: ' + str(error)) from error
+            if previous is not None:
+                return previous
+            if time.monotonic() >= initial_deadline:
+                raise MonitorFailed('No valid initial heartbeat within bounded read window: ' + str(error)) from error
+            time.sleep(.025)
+            continue
+        if not isinstance(heartbeat, dict) or heartbeat.get('token') != token:
+            raise MonitorFailed('Heartbeat token/schema mismatch')
+        expiry = heartbeat.get('expires_unix')
+        if not isinstance(expiry, (int, float)) or not math.isfinite(expiry):
+            raise MonitorFailed('Heartbeat expiry is not a finite timestamp')
+        return heartbeat
 
 
