+def sharing_retry(operation, deadline):
+    delay, attempts = .025, 0
+    while True:
+        try:
+            attempts += 1
+            return operation()
+        except OSError as error:
+            remaining = deadline - time.monotonic()
+            transient = error.errno in (errno.EACCES, errno.EPERM, errno.EBUSY, errno.ETXTBSY)
+            if not transient or remaining <= 0:
+                error.xt_io_attempts = attempts
+                raise
+            time.sleep(min(delay, remaining))
+            delay = min(.2, delay * 2)
 
 
