+def compute_cache_snapshot():
+    """Diagnostic metadata only; never read cache contents or change its path."""
+    result = {'measured_unix': time.time(), 'complete': False}
+    try:
+        folder = Path.home() / '.nv' / 'ComputeCache'
+        result.update(path=str(folder), exists=folder.is_dir(), files=0, bytes=0)
+        if not result['exists']:
+            result['complete'] = True
+            return result
+        pending, deadline = [folder], time.monotonic() + 1.
+        while pending:
+            with os.scandir(pending.pop()) as entries:
+                for entry in entries:
+                    if time.monotonic() >= deadline:
+                        result['diagnostic'] = 'metadata snapshot time budget reached; counts are partial'
+                        return result
+                    if entry.is_dir(follow_symlinks=False):
+                        pending.append(Path(entry.path))
+                    elif entry.is_file(follow_symlinks=False):
+                        result['files'] += 1
+                        result['bytes'] += entry.stat(follow_symlinks=False).st_size
+        result['complete'] = True
+    except Exception as error:
+        result['diagnostic'] = type(error).__name__ + ': ' + str(error)
+    return result
+
+
+def cache_environment_readback(pid, known):
+    """Read only one allowlisted variable from an identity-verified owned child."""
+    result = {'pid': pid, 'verified': False, 'variable': 'CUDA_CACHE_MAXSIZE'}
+    try:
+        before = process_table().get(pid)
+        if before is None or known.get(pid) != before['start_ticks']:
+            raise RuntimeError('owned child identity unavailable')
+        prefix = b'CUDA_CACHE_MAXSIZE='
+        values = [value[len(prefix):] for value in Path('/proc/%d/environ' % pid).read_bytes().split(b'\0')
+                  if value.startswith(prefix)]
+        after = process_table().get(pid)
+        if after is None or after['start_ticks'] != before['start_ticks']:
+            raise RuntimeError('owned child exited or identity changed during readback')
+        value = values[0].decode('ascii') if len(values) == 1 else None
+        if value is not None and not value.isdecimal():
+            raise ValueError('cache size variable is not a decimal byte count')
+        result.update(verified=True, start_ticks=before['start_ticks'], value=value)
+    except Exception as error:
+        result['diagnostic'] = type(error).__name__ + ': ' + str(error)
+    return result
+
