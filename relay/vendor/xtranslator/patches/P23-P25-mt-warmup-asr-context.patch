@@ -232,6 +232,42 @@ class MTGGUFUnsupported(RuntimeError):
                       'fatal': True, 'recoverable': False, 'stage': 'mt_gguf_load'}
 
 
+class MTWarmupFailed(RuntimeError):
+    def __init__(self, detail):
+        super().__init__(detail)
+        self.fault = {'code': 'xt_mt_warmup_failed', 'detail': str(detail),
+                      'fatal': True, 'recoverable': False, 'stage': 'mt_warmup'}
+
+
+def warm_mt(manifest, check, known):
+    """Retain process ownership/heartbeat while one production-client request runs."""
+    started = time.monotonic()
+    log_path = Path(manifest['status_path']).parent / 'mt-warmup.log'
+    env = {**os.environ, **manifest['environment'], **manifest['private_temp_environment'],
+           'KEVFLIX_XT_RUN_TOKEN': manifest['token']}
+    try:
+        with log_path.open('ab', buffering=0) as log:
+            child = subprocess.Popen(manifest['mt_warmup_argv'], env=env, stdin=subprocess.DEVNULL,
+                                     stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
+            row = process_table().get(child.pid)
+            if row:
+                known[child.pid] = row['start_ticks']
+            while child.poll() is None:
+                check()
+                if time.monotonic() - started >= 105.:
+                    raise MTWarmupFailed('MT startup warmup exceeded105s total deadline')
+                time.sleep(.2)
+        if time.monotonic() - started >= 105. or child.returncode:
+            raise MTWarmupFailed('MT startup warmup failed: ' + log_tail(log_path))
+        record = json.loads(Path(manifest['mt_warmup_receipt']).read_text())
+        if record.get('ok') is not True or record.get('movie_credit') is not False \
+                or record.get('audio_generated') is not False or record.get('output_discarded') is not True:
+            raise MTWarmupFailed('Invalid MT startup warmup receipt')
+        return record
+    except (OSError, ValueError) as error:
+        raise MTWarmupFailed(type(error).__name__ + ': ' + str(error)) from error
+
+
