+class MTGGUFUnsupported(RuntimeError):
+    def __init__(self, detail):
+        super().__init__(detail)
+        self.fault = {'code': 'xt_mt_gguf_unsupported', 'detail': str(detail),
+                      'fatal': True, 'recoverable': False, 'stage': 'mt_gguf_load'}
+
+
+def log_tail(path):
+    try:
+        with open(path, 'rb') as handle:
+            handle.seek(0, 2)
+            handle.seek(max(0, handle.tell() - 16384))
+            return handle.read().decode('utf-8', errors='replace')
+    except OSError as error:
+        return str(error)
+
+
+def verify_gguf_header(manifest, check, known):
+    """Owned CPU-only helper; poll lease/floor while it maps metadata, before model launch."""
+    output = Path(manifest['status_path']).parent / 'gguf-header.json'
+    env = {**os.environ, **manifest['environment'], 'CUDA_VISIBLE_DEVICES': '',
+           'KEVFLIX_XT_RUN_TOKEN': manifest['token']}
+    with output.open('wb') as handle:
+        child = subprocess.Popen(manifest['gguf_header_argv'], env=env, stdin=subprocess.DEVNULL,
+                                 stdout=handle, stderr=handle, start_new_session=True)
+        row = process_table().get(child.pid)
+        if row:
+            known[child.pid] = row['start_ticks']
+        deadline = time.monotonic() + min(120, float(manifest['start_timeout_seconds']))
+        while child.poll() is None:
+            check()
+            if time.monotonic() >= deadline:
+                raise MTGGUFUnsupported('CPU header validation deadline exceeded')
+            time.sleep(.2)
+    if child.returncode:
+        raise MTGGUFUnsupported(log_tail(output))
+    try:
+        result = json.loads(output.read_text())
+        if result.get('ok') is not True or result.get('inference') is not False:
+            raise ValueError('header result was not a metadata-only pass')
+        return result
+    except (ValueError, OSError) as error:
+        raise MTGGUFUnsupported(log_tail(output)) from error
+
+
