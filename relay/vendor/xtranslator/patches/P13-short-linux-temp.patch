+def create_short_temp(token):
+    """Linux-native private storage; immutable evidence remains at its original paths."""
+    if Path('/tmp').resolve(strict=True) != Path('/tmp'):
+        raise RuntimeError('XT requires native /tmp, not a redirected temporary root')
+    folder = Path(tempfile.mkdtemp(prefix='xt-', dir='/tmp'))
+    os.chmod(folder, 0o700)
+    stat = folder.stat()
+    owner = {'owner': 'kevflix-xtranslator', 'token': token, 'path': str(folder), 'device': stat.st_dev, 'inode': stat.st_ino,
+             'uid': stat.st_uid, 'supervisor_pid': os.getpid()}
+    atomic_json(folder / '.xt-owner.json', owner)
+    # Installed vLLM 0.14 network_utils.py:143 appends '/' + str(uuid4()).
+    # Linux sockaddr_un has 108 bytes including the terminating NUL.
+    socket_bytes = len((str(folder) + '/' + '00000000-0000-0000-0000-000000000000').encode('utf-8'))
+    return {'owner': owner, 'created_unix': time.time(), 'mode': '0700',
+            'vllm_socket_path_bytes': socket_bytes, 'socket_path_limit_bytes': 107,
+            'socket_path_safety_margin_bytes': 16,
+            'environment': {key: str(folder) for key in ('TMPDIR', 'TEMP', 'TMP', 'VLLM_RPC_BASE_PATH')},
+            'removed': False}
+
+
+def cleanup_short_temp(record, token, processes_confirmed):
+    if record is None:
+        return None
+    result = dict(record)
+    if not processes_confirmed:
+        result.update(removed=False, cleanup_reason='preserved: process/GPU cleanup unconfirmed')
+        return result
+    try:
+        owner = record['owner']
+        folder = Path(owner['path'])
+        if owner.get('owner') != 'kevflix-xtranslator' or owner.get('token') != token \
+                or folder.parent != Path('/tmp') or not folder.name.startswith('xt-') \
+                or folder.is_symlink() or folder.resolve() != folder:
+            raise RuntimeError('private temp ownership/path mismatch')
+        if not folder.exists():
+            result.update(removed=True, cleanup_reason='already absent after confirmed process cleanup')
+            return result
+        stat = folder.stat()
+        if (stat.st_dev, stat.st_ino, stat.st_uid) != (owner['device'], owner['inode'], owner['uid']) \
+                or (stat.st_mode & 0o777) != 0o700 \
+                or json.loads((folder / '.xt-owner.json').read_text()) != owner:
+            raise RuntimeError('private temp identity/marker changed; preserving directory')
+        if not shutil.rmtree.avoids_symlink_attacks:
+            raise RuntimeError('safe Linux directory cleanup is unavailable')
+        shutil.rmtree(folder)
+        result.update(removed=True, cleanup_reason='removed after confirmed owned process/GPU cleanup')
+    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
+        result.update(removed=False, cleanup_reason=str(error))
+    return result
+
